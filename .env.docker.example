# ============================================
# .env.docker — Environment variables for Docker
# ============================================
# Copy this file:  cp .env.docker.example .env.docker
# Then fill in your actual values.
#
# NOTE: DATABASE_URL, DIRECT_URL, and REDIS_URL are already
# set in docker-compose.yml (pointing to the containers),
# so you do NOT need them here.
# ============================================

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Google OAuth (for login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini API (for AI generation)
GEMINI_API_KEY="your-gemini-api-key"

# Polar.sh (Payments)
POLAR_ACCESS_TOKEN="your-polar-access-token"
POLAR_PRODUCT_ID="your-polar-product-id"
POLAR_WEBHOOK_SECRET="your-polar-webhook-secret"

# Supabase Storage (for AI-generated images)
# Even with Docker PostgreSQL, we still use Supabase for file storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
